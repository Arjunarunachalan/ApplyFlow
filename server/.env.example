PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auto-apply?retryWrites=true&w=majority
DNS_SERVERS=8.8.8.8,1.1.1.1
REDIS_URL=rediss://default:<password>@<host>:6379

# Single-user authentication (optional; set AUTH_REQUIRED=true to require login)
AUTH_REQUIRED=false
AUTH_SECRET=replace_with_at_least_32_char_random_hex_secret
CLIENT_URL=http://localhost:3000
# Optional bootstrap owner account on empty database:
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=change_me_min_8_chars
# ADMIN_NAME=Owner

# Gmail SMTP (App Password - legacy transport until Gmail OAuth in Phase 5)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# AI Provider: template | gemini | ollama
AI_PROVIDER=template
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.8-flash
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b
# OLLAMA_VISION_MODEL=llama3.2-vision
# SCREENSHOT_RETENTION_HOURS=72

DAILY_EMAIL_LIMIT=20
EMAIL_MIN_DELAY_MS=15000
EMAIL_MAX_DELAY_MS=40000
